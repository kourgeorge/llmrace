{
  "name": "llmrace",
  "type": "module",
  "version": "0.1.1",
  "description": "Fast.com but for LLMs — a CLI benchmark tool that races LLM providers head-to-head on tokens/sec, time-to-first-token, and total latency.",
  "license": "MIT",
  "bin": {
    "llmrace": "dist/bench.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bench": "tsx scripts/bench.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.3"
  }
}
