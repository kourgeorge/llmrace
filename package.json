{
  "name": "llmrace",
  "type": "module",
  "version": "0.1.1",
  "description": "Speedtest.net for LLMs — a CLI tool that benchmarks a single model's tokens/sec, time-to-first-token, and total latency, with optional head-to-head races between providers.",
  "license": "MIT",
  "author": "George Kour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kourgeorge/llmrace.git"
  },
  "homepage": "https://github.com/kourgeorge/llmrace#readme",
  "bugs": {
    "url": "https://github.com/kourgeorge/llmrace/issues"
  },
  "keywords": [
    "llm",
    "benchmark",
    "cli",
    "latency",
    "tokens-per-second",
    "ttft",
    "openai",
    "anthropic",
    "groq",
    "cerebras",
    "ollama"
  ],
  "bin": {
    "llmrace": "dist/bench.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bench": "tsx scripts/bench.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.3"
  }
}
