# Copy to .env and fill in the keys for whichever providers you want to benchmark.
# bench.ts loads this automatically. Each provider looks for <PROVIDER>_API_KEY,
# or pass --api-key on the command line to override.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
META_API_KEY=
KIMI_API_KEY=

# Local provider (Ollama, LM Studio, llama.cpp, etc.) — no key needed by default.
# Set a base URL with --base-url or LOCAL_BASE_URL if it's not the Ollama default.
